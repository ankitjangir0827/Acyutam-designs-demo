rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated in Firebase
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Check if user is Master Admin (ankitjangir529@gmail.com)
    function isAdmin() {
      return isSignedIn() && 
        request.auth.token.email != null && 
        request.auth.token.email.lower() == 'ankitjangir529@gmail.com';
    }

    // Helper: Check if user is document owner by path UID
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Helper: Check if user owns document by record content fields
    function isDocOwner() {
      return isSignedIn() && (
        resource != null && (
          resource.data.userId == request.auth.uid || 
          (resource.data.useremail != null && resource.data.useremail.lower() == request.auth.token.email.lower()) ||
          (resource.data.userEmail != null && resource.data.userEmail.lower() == request.auth.token.email.lower()) ||
          (resource.data.email != null && resource.data.email.lower() == request.auth.token.email.lower()) ||
          (resource.data["user email id"] != null && resource.data["user email id"].lower() == request.auth.token.email.lower())
        )
      );
    }

    // 1. Projects Collection: Publicly readable for architectural portfolio showcase; write/update/delete strictly for Master Admin
    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // 2. Main User Data Collection: /userdata/{docId}
    match /userdata/{docId} {
      allow create, update: if isSignedIn();
      allow read, delete: if isAdmin() || isOwner(docId) || isDocOwner();
    }

    // 3. Users Collection: /users/{userId}
    match /users/{userId} {
      allow read, write: if isAdmin() || isOwner(userId);
    }

    // 4. Enquiries Collection: /enquiries/{enquiryId}
    // Allow public & authenticated creation (contact form / modals); read, update, delete reserved for Admin or document owner
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || isDocOwner();
    }

    // 5. Enquire Collection: /Enquire/{enquiryId}
    match /Enquire/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin() || isDocOwner();
    }

    // 6. Careers Collection: /careers/{careerId}
    // Allow public creation of job applications; read, update, delete reserved strictly for Master Admin
    match /careers/{careerId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 7. Email OTPs Collection: /email_otps/{emailId}
    // Allow creation, reading & updating for OTP verification during Sign Up
    match /email_otps/{emailId} {
      allow create, read, update: if true;
      allow delete: if isAdmin();
    }

    // Default deny all unlisted paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


